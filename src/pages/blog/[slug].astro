
---
import { supabase } from "../../lib/supabase";

const slug = Astro.params.slug;
let post = null;

if (supabase && slug) {
  const { data } = await supabase
    .from("blog_posts")
    .select("title, slug, excerpt, content, featured_image_url, published_at, meta_title, meta_description")
    .eq("slug", slug)
    .eq("published", true)
    .maybeSingle();

  post = data;
}

if (!post) {
  Astro.response.status = 404;
}

const title = post?.meta_title || post?.title || "Blog Article";
const description =
  post?.meta_description ||
  post?.excerpt ||
  "Read travel tips and helpful flight-planning information.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <main>
      <p><a href="/">Home</a> / <a href="/blog">Blog</a></p>

      {post ? (
        <article>
          <h1>{post.title}</h1>
          {post.published_at && (
            <p>
              Published on{" "}
              {new Date(post.published_at).toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric"
              })}
            </p>
          )}
          {post.featured_image_url && (
            <img src={post.featured_image_url} alt={post.title} />
          )}
          <p>{post.excerpt}</p>
          <div style="white-space: pre-wrap">{post.content}</div>
        </article>
      ) : (
        <>
          <h1>Article not found</h1>
          <p>This article doesn't exist or hasn't been published.</p>
          <a href="/blog">Browse the blog</a>
        </>
      )}
    </main>
  </body>
</html>
